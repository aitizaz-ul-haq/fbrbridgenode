NODE_ENV=development
PORT=3001
# Bind to loopback in production; Nginx terminates TLS and proxies to this.
HOST=127.0.0.1

FBR_BASE_URL=https://gw.fbr.gov.pk/di_data/v1/di
FBR_SANDBOX_TOKEN=replace_with_real_sandbox_token
# Optional. Required only for production submissions (X-FBR-Environment: production).
FBR_PRODUCTION_TOKEN=replace_with_real_production_token

# Long random internal key shared only between the Next.js backend and this bridge.
BRIDGE_API_KEY=replace_with_long_random_internal_key

# Comma separated list. No wildcards.
ALLOWED_ORIGINS=https://your-nextjs-domain.example

REQUEST_TIMEOUT_MS=30000
LOG_LEVEL=info

# Mock mode returns fake FBR responses without calling FBR.
# Must never be enabled in production.
FBR_MOCK_MODE=true
